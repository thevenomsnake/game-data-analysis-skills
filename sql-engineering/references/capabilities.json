{
  "schema_version": "sql_capability_registry_v1",
  "governance_modes": [
    "PROJECT_ADMIN",
    "SKILL_EVOLUTION",
    "RULES",
    "SOURCE_INTAKE",
    "KNOWLEDGE",
    "REQUIREMENT_INTAKE",
