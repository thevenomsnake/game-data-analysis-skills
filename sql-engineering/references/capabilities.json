  "common_actions": [
    {
      "id": "INSPECT_DEV_DATA",
      "label": "检查开发库数据",
      "function_ids": [
        "DEV_SQL_INSPECT"
      ],
      "description": "检索历史证据，或只读查看开发库表结构、字段枚举和小范围诊断结果。"
    },
    {
      "id": "QUERY_WORK",
      "label": "查数据 / 修改 SQL",
      "function_ids": [
        "QUERY",
        "QUERY_EXECUTE"
      ],
      "description": "生成、修改并保存查询 SQL；需要执行时只消费准确 receipt，并使用公开配置的本地适配器或 Chrome 插件。"
    },
    {
      "id": "FORMALIZE",
      "label": "固化 SQL",
      "function_ids": [
        "SQL_FORMALIZE"
      ],
      "description": "把已跑通 SQL 和结果证据固化为正式 QUERY，并按需生成 Dashboard。"
    },
    {
      "id": "VISUALIZE_SQL_RESULT",
      "label": "可视化 SQL 结果",
      "function_ids": [
        "RESULT_VISUALIZATION"
      ],
      "description": "准确 SQL 返回结果后，Bug 排查默认生成自包含 HTML，传统分析默认生成 Excel，并绑定准确结果 lineage。"
    },
    {
      "id": "ORGANIZE_RESULT_LINEAGE",
      "label": "整理结果与可视化",
      "function_ids": [
        "RESULT_LINEAGE_ORGANIZATION"
      ],
      "description": "定期识别结果、Excel 和可视化的准确来源；LLM 必须讲清关键差异，再逐项由用户确认。"
    },
    {
      "id": "REVIEW_SQL",
      "label": "审查 SQL",
      "function_ids": [
        "REVIEW"
      ],
      "description": "从产品和代码两个视角审查原始 SQL。"
    },
    {
      "id": "FIND_SQL",
      "label": "查找 SQL",
      "function_ids": [
        "QUERY",
        "SQL_REPOSITORY"
      ],
      "description": "按用途、指标、日志和筛选查找临时历史或正式资产。"
    },
    {
      "id": "BROWSE_ALL_ASSETS",
      "label": "浏览全部资产",
      "function_ids": [
        "ASSET_CATALOG",
        "ASSET_ORGANIZATION"
      ],
      "description": "按显式定期任务生成共享资产全状态只读目录，排除本地 query workspace，增量整理业务语义，并为分析问题分配永久 AG 编号和主页目录。"
    },
    {
      "id": "CURATE_QUERY_WORKSPACE",
      "label": "整理临时 SQL",
      "function_ids": [
        "QUERY_WORKSPACE_MAINTENANCE",
        "RESULT_EVIDENCE_MAINTENANCE"
      ],
      "description": "定期分类、查重并动态浏览 query workspace；原始结果超过 10 MB 时切片，完整保留可视化，不改 SQL 或生命周期。"
    },
    {
      "id": "MANAGE_RULES",
      "label": "管理口径",
      "function_ids": [
        "RULES"
      ],
      "description": "查看或经明确授权写入项目 canonical rules。"
    },
    {
      "id": "MANAGE_KNOWLEDGE",
      "label": "查询 / 管理资料库",
      "function_ids": [
        "KNOWLEDGE"
      ],
      "description": "优先从项目 active bindings 发现并只读查询映射、枚举、QA/Owner/负责人等可变参考信息；显式授权后才登记、刷新或绑定资料。"
    },
    {
      "id": "DISCOVER_SOURCE_MATERIALS",
      "label": "初始化 / 扫描资料目录",
      "function_ids": [
        "SOURCE_WORKSPACE"
      ],
      "description": "配置本机未确认代码、TLOG 文档或外部参考目录，生成候选文件索引，并选择一个准确来源供后续 KNOWLEDGE 审查。"
    },
    {
      "id": "MANAGE_PLANNING_SOURCE",
      "label": "配置 / 同步策划表",
      "function_ids": [
        "PLANNING_SOURCE"
      ],
      "description": "安装时选择 Git、SVN、本地目录或 none；同步到本地后按产品和阶段封存精确版本并维护 source release 绑定。"
    },
    {
      "id": "MANAGE_PROJECT",
      "label": "开始配置 / 修改配置",
      "function_ids": [
        "PROJECT_ADMIN"
      ],
      "description": "检查尚未配置的项目项，让用户逐阶段确认、复制或停用内网/DA 数据服务绑定，并持久化策划源、本机凭据和本地身份；也支持显式修改已有配置。"
    },
    {
      "id": "SYNC_MATERIALS",
      "label": "同步资料",
      "function_ids": [
        "COLLABORATION_SUBMIT"
      ],
      "description": "生成本地安全提交计划；不自动推送，不读取生产项目或结果。"
    }
  ],
  "functions": [
    {
      "id": "PROJECT_ADMIN",
      "label": "项目管理",
      "governance_mode": "PROJECT_ADMIN",
      "audience": "common",
      "use_when": "成员安装 SQL Engineering 后说‘开始配置’或‘修改配置’，需要初始化明确的产品阶段、逐用途确认或复制数据服务绑定、持久化策划源/本机凭据/本地身份，或检查、迁移项目空间、配置、manifest 和索引。",
      "required_context": [
        "项目 slug 或项目根目录"
      ],
      "entrypoints": [
        "workspace_setup.py status|sync",
        "data_service.py status|init|copy|bind|disable|resolve",
        "local_setup.py status|init --execution-surface manual|direct|web",
        "planning_source.py status|configure",
        "sql_project.py init|show-config|set-config|rebuild-index",
        "project_validate.py",
        "migrate_*.py"
      ],
      "writes_assets": true,
      "llm_policy": "none",
      "quality_profile": "project_admin",
      "references": [
        "setup-onboarding.md",
        "data-services.md",
        "local-setup.md",
        "planning-source.md",
        "operating-contract.md",
        "project-workflow.md"
      ],
      "outputs": [
        "产品阶段与数据服务绑定状态",
        "配置清单与缺失项",
        "持久化本机配置",
        "项目配置",
        "manifest/index",
        "迁移或健康报告"
      ],
      "aliases": [
        "开始配置",
        "修改配置",
        "检查配置"
      ]
    },
    {
      "id": "SKILL_EVOLUTION",
      "label": "SQL Skill进化",
      "governance_mode": "SKILL_EVOLUTION",
      "audience": "advanced",
      "use_when": "用户明确要求进化、重构、修复或更新 SQL Engineering Skill 本身的脚本、测试、schema 或说明。不得由普通 QUERY 发现问题后自行升级进入。",
      "required_context": [
        "明确的 skill 改造请求",
        "失败案例或目标行为"
      ],
      "entrypoints": [
        "write_scope_guard.py",
        "sql-engineering source/tests/references"
      ],
      "writes_assets": true,
      "llm_policy": "engineering_change_with_regression_tests",
      "quality_profile": "skill_source_change",
      "references": [
        "sql-workflow-optimization-record.md"
      ],
      "outputs": [
        "skill source change",
        "regression tests",
        "runtime sync"
      ],
      "aliases": [
        "Skill进化",
        "skills进化",
        "SQL skill改造"
      ]
    },
    {
      "id": "RULES",
      "label": "口径管理",
      "governance_mode": "RULES",
      "audience": "common",
      "use_when": "查看、审查或经用户明确授权写入项目 canonical rules。",
      "required_context": [
        "项目",
        "口径内容或 concept_key"
      ],
      "entrypoints": [
        "sql_project.py show-rules|rule-report|add-rule",
        "rule_review.py",
        "rule_dictionary.py",
        "rule_authorization_governance.py"
      ],
      "writes_assets": true,
      "llm_policy": "optional_semantic_structuring",
      "quality_profile": "canonical_rule_write",
      "references": [
        "rule-manager.md",
        "rule-context-event-signatures.md"
      ],
      "outputs": [
        "canonical rule",
        "口径审查或字典"
      ],
      "aliases": []
    },
    {
      "id": "SOURCE_INTAKE",
      "label": "来源/XML同步",
      "governance_mode": "SOURCE_INTAKE",
      "audience": "advanced",
      "use_when": "同步 XML/TLOG 结构、日志名、字段、类型、描述，生成字段目录或登记外部来源契约；XML 不能推断可变的 QA、Owner、负责人或联系人。",
      "required_context": [
        "项目",
        "XML/TLOG 或来源证据"
      ],
      "entrypoints": [
        "xml_catalog.py"
      ],
      "writes_assets": true,
      "llm_policy": "none",
      "quality_profile": "source_intake",
      "references": [
        "source-index.md"
      ],
      "outputs": [
        "xml_catalog.json",
        "项目来源证据"
      ],
      "aliases": []
    },
    {
      "id": "SOURCE_WORKSPACE",
      "label": "候选资料目录",
      "governance_mode": "SOURCE_INTAKE",
      "audience": "common",
      "use_when": "初始化或扫描成员本机的代码资料、TLOG 文档等未确认来源目录，或从目录中选择一个准确文件供后续资料库审查；完整策划表目录改用 PLANNING_SOURCE。",
      "required_context": [
        "仓库根目录",
        "本机来源目录或已配置 root_id",
        "可选项目范围"
      ],
      "entrypoints": [
        "source_workspace.py configure|list|scan|select"
      ],
      "writes_assets": true,
      "llm_policy": "none_for_discovery_optional_for_later_knowledge_review",
      "quality_profile": "local_only_unconfirmed_no_implicit_promotion",
      "references": [
        "source-workspace.md",
        "knowledge-management.md",
        "operating-contract.md"
      ],
      "outputs": [
        "本机 source root 配置",
        "候选资料索引",
        "selected_not_reviewed 选择凭据"
      ],
      "aliases": [
        "扫描候选资料",
        "未确认代码资料",
        "未确认外部资料"
      ]
    },
    {
      "id": "PLANNING_SOURCE",
      "label": "策划源空间",
      "governance_mode": "SOURCE_INTAKE",
      "audience": "common",
      "use_when": "配置、修改、检查、同步或查看一个产品阶段的策划源；安装层先选择 Git、SVN、本地目录或 none，正式生命周期再封存精确 SVN revision 或本地目录快照。",
      "required_context": [
        "SQL 项目",
        "产品与阶段",
        "安装时选择的 Git/SVN/local provider 与本地同步路径",
        "明确的管理方式"
