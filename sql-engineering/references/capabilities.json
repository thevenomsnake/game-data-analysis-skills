  "protected_writes": [
    {
      "scope": "skill_source",
      "allowed_function_ids": [
        "SKILL_EVOLUTION"
      ],
      "reason": "SQL generation and project workflows must treat source/runtime skill files as read-only."
    },
    {
      "scope": "canonical_rules",
      "allowed_function_ids": [
        "RULES"
      ],
      "reason": "Canonical rules and their change log require a separately authorized RULES request."
    },
    {
      "scope": "knowledge_assets",
      "allowed_function_ids": [
        "KNOWLEDGE"
      ],
      "reason": "Knowledge snapshots, projections, usage contracts, and project bindings require an explicit knowledge-management request."
    },
    {
      "scope": "planning_sources",
      "allowed_function_ids": [
        "PLANNING_SOURCE",
        "PROJECT_ADMIN"
      ],
      "reason": "Complete planning releases and project source bindings require the planning-source or setup workflow."
    }
  ],
