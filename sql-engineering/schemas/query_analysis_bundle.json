{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query Analysis Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "title",
    "purpose",
    "status",
    "summary_plan",
    "metric_contract_fingerprint",
    "parameter_snapshot",
    "parameter_fingerprint",
    "source_tables",
    "filter_contract",
    "members",
    "result_bindings",
    "visualization",
    "generation_provenance",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "query_analysis_bundle_v1" },
    "bundle_id": { "type": "string", "pattern": "^qab-[a-f0-9]{12}$" },
    "title": { "type": "string", "minLength": 2 },
    "purpose": { "type": "string", "minLength": 6 },
    "status": { "enum": ["awaiting_results", "ready_for_visualization", "visualized"] },
    "summary_plan": { "$ref": "summary_feasibility.json" },
    "metric_contract_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parameter_snapshot": { "type": "object" },
    "parameter_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_tables": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "filter_contract": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "query_id", "version", "path", "sql_fingerprint", "logic_fingerprint", "expected_fields"],
        "properties": {
          "role": { "enum": ["grouped", "overall"] },
          "query_id": { "type": "string", "pattern": "^qw-[a-z0-9-]+$" },
          "version": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "pattern": "^query_workspace/.+\\.sql$" },
          "sql_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "logic_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "expected_fields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "result_bindings": {
      "type": "object",
      "properties": {
        "grouped": { "$ref": "#/$defs/result_binding" },
        "overall": { "$ref": "#/$defs/result_binding" }
      },
      "additionalProperties": false
    },
    "visualization": {
      "oneOf": [
        { "type": "object", "maxProperties": 0 },
        {
          "type": "object",
          "required": ["query_id", "version", "attachment_id", "path", "source_result_ids"],
          "properties": {
            "query_id": { "type": "string", "pattern": "^qw-[a-z0-9-]+$" },
            "version": { "type": "integer", "minimum": 1 },
            "attachment_id": { "type": "string", "pattern": "^qwo-[a-f0-9]{12}$" },
            "path": { "type": "string", "pattern": "^query_workspace/.+/outputs/v[0-9]{3}/.+" },
            "kind": { "enum": ["visualization", "analysis_workbook", "comparison_workbook"] },
            "source_result_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^qwo-[a-f0-9]{12}$" }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      ]
    },
    "generation_provenance": { "type": "object" },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "result_binding": {
      "type": "object",
      "required": ["query_id", "version", "result_id", "path", "source_sha256", "columns", "attached_at"],
      "properties": {
        "query_id": { "type": "string", "pattern": "^qw-[a-z0-9-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "result_id": { "type": "string", "pattern": "^qwo-[a-f0-9]{12}$" },
        "path": { "type": "string", "pattern": "^query_workspace/.+/outputs/v[0-9]{3}/.+" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "attached_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
