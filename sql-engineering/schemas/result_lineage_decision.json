{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result Lineage Human Decision",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "project_id",
    "status",
    "user_request",
    "confirmed_at",
    "actions"
  ],
  "properties": {
    "schema_version": { "const": "result_lineage_decision_v1" },
    "decision_id": { "type": "string", "pattern": "^rld-[a-z0-9-]+$" },
    "project_id": { "type": "string", "minLength": 2 },
    "status": { "const": "user_confirmed" },
    "user_request": { "type": "string", "minLength": 1 },
    "confirmed_at": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asset_selector": {
      "type": "object",
      "required": ["query_id", "version", "attachment_id"],
      "properties": {
        "query_id": { "type": "string", "pattern": "^qw-[a-z0-9-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "attachment_id": { "type": "string", "pattern": "^qwo-[a-f0-9]{12}$" }
      },
      "additionalProperties": false
    },
    "result_selector": {
      "type": "object",
      "required": ["query_id", "version", "result_id"],
      "properties": {
        "query_id": { "type": "string", "pattern": "^qw-[a-z0-9-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "result_id": { "type": "string", "pattern": "^qwo-[a-f0-9]{12}$" }
      },
      "additionalProperties": false
    },
    "semantic_review": {
      "type": "object",
      "required": ["summary", "key_differences", "coverage", "risk_if_wrong", "recommendation", "confidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 8 },
        "key_differences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        },
        "coverage": { "enum": ["same", "strict_superset", "partial_overlap", "different", "unknown"] },
        "risk_if_wrong": { "type": "string", "minLength": 6 },
        "recommendation": { "type": "string", "minLength": 4 },
        "confidence": { "enum": ["high", "medium", "low"] }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "required": ["kind", "description", "equivalence_preserved"],
      "properties": {
        "kind": { "enum": ["filter", "mapping", "projection", "regrouping", "merge", "visualization", "other"] },
        "description": { "type": "string", "minLength": 6 },
        "equivalence_preserved": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["action_id", "action", "semantic_review", "user_confirmation"],
      "properties": {
        "action_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "action": { "enum": ["bind", "adopt_bundle", "supersede", "discard", "deduplicate", "register_result", "remove_duplicate_file"] },
        "target": { "$ref": "#/$defs/asset_selector" },
        "bundle": {
          "type": "string",
          "pattern": "^(qab-[a-f0-9]{12}|query_workspace/bundles/qab-[a-f0-9]{12}\\.json)$"
        },
        "bundle_results": {
          "type": "object",
          "required": ["grouped", "overall"],
          "properties": {
            "grouped": { "$ref": "#/$defs/result_selector" },
            "overall": { "$ref": "#/$defs/result_selector" }
          },
          "additionalProperties": false
        },
        "canonical_output": { "$ref": "#/$defs/asset_selector" },
        "source_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/result_selector" }
        },
        "lineage_status": { "enum": ["exact_result", "exact_results", "deterministic_transform"] },
        "transformation": { "$ref": "#/$defs/transformation" },
        "existing_result_path": { "type": "string", "pattern": "^query_workspace/.+/outputs/v[0-9]{3}/.+" },
        "title": { "type": "string", "minLength": 2 },
        "purpose": { "type": "string", "minLength": 6 },
        "duplicate_path": { "type": "string", "pattern": "^query_workspace/.+/outputs/v[0-9]{3}/.+" },
        "semantic_review": { "$ref": "#/$defs/semantic_review" },
        "user_confirmation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
