{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formal Asset Migration Plan",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_manifest",
    "source_manifest_sha256",
    "formal_status",
    "archive_status",
    "packages",
    "files",
    "formal_unresolved",
    "archive",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "formal_asset_migration_plan_v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "source_manifest": { "const": "manifest.json" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "formal_status": { "enum": ["ready", "blocked"] },
    "archive_status": { "enum": ["ready", "needs_decision"] },
    "packages": { "type": "array", "items": { "type": "object" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "formal_unresolved": { "type": "array", "items": { "type": "object" } },
    "archive": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "source_path",
        "source_sha256",
        "size_bytes",
        "action",
        "package_id",
        "package_slug",
        "member_id",
        "member_role",
        "lifecycle_state",
        "target_path",
        "reason"
      ],
      "properties": {
        "source_path": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "action": { "const": "move_to_package" },
        "package_id": { "type": "string", "pattern": "^FA-[0-9]{4,}$" },
        "package_slug": { "type": "string" },
        "member_id": { "type": "string" },
        "member_role": { "type": "string" },
        "lifecycle_state": { "enum": ["current", "history", "archived"] },
        "target_path": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
