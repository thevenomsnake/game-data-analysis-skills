{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Rule Record",
  "type": "object",
  "required": [
    "rule_id",
    "concept_key",
    "version",
    "status",
    "title",
    "content",
    "source",
    "confirmed_by_user",
    "applies_to",
    "created_at"
  ],
  "properties": {
    "rule_id": { "type": "string", "minLength": 1 },
    "concept_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["proposed", "confirmed", "deprecated", "superseded"] },
    "title": { "type": "string", "minLength": 1 },
    "content": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "source_evidence": { "type": "string" },
    "confirmed_by_user": { "type": "boolean" },
    "scope": { "enum": ["session", "artifact", "project"] },
    "lifetime": { "enum": ["temporary", "persistent"] },
    "applies_to": { "type": "string" },
    "affected_artifacts": { "type": "array", "items": { "type": "string" } },
    "decision_question": { "type": "string" },
    "supersedes": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "notes": { "type": "string" },
    "change_authorization": { "type": "object" },
    "structured_definition": {
      "type": "object",
      "properties": {
        "knowledge_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dataset_id",
              "projection_id",
              "semantic_role",
              "fields",
              "required",
              "binding_policy"
            ],
            "properties": {
              "dataset_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$" },
              "dataset_version": { "type": "string", "pattern": "^kdv-[a-f0-9]{12}$" },
              "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "projection_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$" },
              "projection_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "semantic_role": {
                "enum": [
                  "label_mapping",
                  "classification",
                  "filter_set",
                  "parameter_source",
                  "field_semantics",
                  "authoring_reference"
                ]
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "required": { "type": "boolean" },
              "binding_policy": { "enum": ["active_project_binding", "exact"] }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "binding_policy": { "const": "exact" } },
                  "required": ["binding_policy"]
                },
                "then": {
                  "required": ["dataset_version", "content_hash", "projection_sha256"]
                }
              },
              {
                "if": {
                  "properties": { "binding_policy": { "const": "active_project_binding" } },
                  "required": ["binding_policy"]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      { "required": ["dataset_version"] },
                      { "required": ["content_hash"] },
                      { "required": ["projection_sha256"] }
                    ]
                  }
                }
              }
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "activation_contract": {
      "description": "Current confirmed records must use canonical_rule_activation_v2. Historical immutable records may retain old objects, but runtime consumers never activate or derive from them.",
      "type": "object"
    }
  },
  "additionalProperties": true
}
