{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL Engineering Stable Asset Group Registry",
  "type": "object",
  "required": [
    "schema_version",
    "source_model",
    "generated_at",
    "catalog_path",
    "catalog_fingerprint",
    "organization_path",
    "organization_fingerprint",
    "generation_provenance",
    "id_policy",
    "grouping_policy",
    "summary",
    "groups",
    "unassigned_asset_ids",
    "issues"
  ],
  "properties": {
    "schema_version": { "const": "sql_asset_group_registry_v2" },
    "source_model": { "const": "catalog_and_organization_only" },
    "generated_at": { "type": "string", "minLength": 1 },
    "catalog_path": { "$ref": "#/$defs/relative_path" },
    "catalog_fingerprint": { "$ref": "#/$defs/sha256" },
    "organization_path": { "$ref": "#/$defs/relative_path" },
    "organization_fingerprint": { "$ref": "#/$defs/sha256" },
    "generation_provenance": { "type": "object" },
    "id_policy": {
      "type": "object",
      "required": [
        "prefix",
        "minimum_width",
        "next_sequence",
        "immutable_after_assignment",
        "late_imports_do_not_renumber",
        "sql_version_namespace_is_separate",
        "formal_asset_identity_is_preserved"
      ],
      "properties": {
        "prefix": { "const": "AG-" },
        "minimum_width": { "const": 4 },
        "next_sequence": { "type": "integer", "minimum": 1 },
        "immutable_after_assignment": { "const": true },
        "late_imports_do_not_renumber": { "const": true },
        "sql_version_namespace_is_separate": { "const": true }
        ,
        "formal_asset_identity_is_preserved": { "const": true }
      },
      "additionalProperties": false
    },
    "grouping_policy": {
      "type": "object",
      "required": [
        "unit",
        "uses_text_similarity",
        "uses_business_topic_as_identity",
        "package_membership_is_authoritative",
        "strong_relations",
        "eligible_asset_kinds"
      ],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "uses_text_similarity": { "const": false },
        "uses_business_topic_as_identity": { "const": false },
        "package_membership_is_authoritative": { "const": true },
        "strong_relations": { "$ref": "#/$defs/unique_strings" },
        "eligible_asset_kinds": { "$ref": "#/$defs/unique_strings" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "eligible_asset_count",
        "group_count",
        "active_group_count",
        "catalog_missing_group_count",
        "grouped_current_asset_count",
        "unassigned_asset_count",
        "issue_count",
        "groups_by_navigation_path"
      ],
      "properties": {
        "eligible_asset_count": { "type": "integer", "minimum": 0 },
        "group_count": { "type": "integer", "minimum": 0 },
        "active_group_count": { "type": "integer", "minimum": 0 },
        "catalog_missing_group_count": { "type": "integer", "minimum": 0 },
        "grouped_current_asset_count": { "type": "integer", "minimum": 0 },
        "unassigned_asset_count": { "type": "integer", "minimum": 0 },
        "issue_count": { "type": "integer", "minimum": 0 },
        "groups_by_navigation_path": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "unassigned_asset_ids": { "$ref": "#/$defs/unique_strings" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "unique_strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "sequence",
        "display_order",
        "display_title",
        "semantic_summary",
        "navigation_path",
        "project_ids",
        "formal_asset_ids",
        "first_managed_at",
        "last_activity_at",
        "assigned_at",
        "updated_at",
        "group_state",
        "curation_state",
        "classification_source",
        "root_asset_ids",
        "member_asset_ids",
        "catalog_missing_member_asset_ids",
        "member_counts_by_kind",
        "notes",
        "group_fingerprint"
      ],
      "properties": {
        "group_id": { "type": "string", "pattern": "^AG-[0-9]{4,}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "display_order": { "type": "integer", "minimum": 1 },
        "display_title": { "type": "string", "minLength": 1 },
        "semantic_summary": { "type": "string" },
        "navigation_path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "project_ids": { "$ref": "#/$defs/unique_strings" },
        "formal_asset_ids": { "$ref": "#/$defs/unique_strings" },
        "first_managed_at": { "type": "string", "minLength": 1 },
        "last_activity_at": { "type": "string" },
        "assigned_at": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 },
        "group_state": { "enum": ["active", "catalog_missing"] },
        "curation_state": { "enum": ["current", "needs_group_review", "catalog_missing"] },
        "classification_source": { "enum": ["deterministic", "llm", "human"] },
        "root_asset_ids": { "$ref": "#/$defs/unique_strings" },
        "member_asset_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "catalog_missing_member_asset_ids": { "$ref": "#/$defs/unique_strings" },
        "member_counts_by_kind": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "notes": { "type": "string" },
        "group_fingerprint": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "message", "group_id", "asset_ids"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "group_id": { "type": "string" },
        "asset_ids": { "$ref": "#/$defs/unique_strings" }
      },
      "additionalProperties": false
    }
  }
}
