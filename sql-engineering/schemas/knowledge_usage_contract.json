{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Dataset Usage Contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "dataset_id",
    "status",
    "display_name",
    "source_kind",
    "business_domain",
    "project_scopes",
    "purpose",
    "exclusions",
    "projections",
    "governance"
  ],
  "properties": {
    "schema_version": { "const": "knowledge_usage_contract_v1" },
    "contract_version": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$" },
    "status": { "enum": ["draft", "active", "deprecated"] },
    "display_name": { "type": "string", "minLength": 2 },
    "source_kind": { "enum": ["config_excel", "manual_mapping", "external_reference"] },
    "business_domain": { "type": "string", "minLength": 2 },
    "project_scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "purpose": { "type": "string", "minLength": 8 },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "projection_id",
          "source_output",
          "description",
          "primary_key",
          "required_fields",
          "default_fields",
          "allowed_fields",
          "allowed_usage_modes",
          "allowed_usages",
          "forbidden_usages"
        ],
        "properties": {
          "projection_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$" },
          "source_output": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 4 },
          "primary_key": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "required_fields": { "type": "array", "items": { "type": "string" } },
          "default_fields": { "type": "array", "items": { "type": "string" } },
          "allowed_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "field_roles": { "type": "object", "additionalProperties": { "type": "string" } },
          "allowed_usage_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["inline_mapping", "filter_set", "result_enrichment", "authoring_reference", "materialized_dimension"]
            }
          },
          "limits": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
          "log_bindings": { "type": "array", "items": { "type": "object" } },
          "allowed_usages": { "type": "array", "items": { "type": "string" } },
          "forbidden_usages": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": ["runtime_excel_dependency", "activation_policy", "materialized_dimension_requires_approval"],
      "properties": {
        "runtime_excel_dependency": { "const": "forbidden" },
        "activation_policy": { "const": "explicit_project_binding" },
        "materialized_dimension_requires_approval": { "type": "boolean" },
        "refresh_policy": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
