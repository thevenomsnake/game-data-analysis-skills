{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Planning Source Projection Spec",
  "type": "object",
  "required": ["schema_version", "table_id", "status", "source", "sheets", "validation"],
  "properties": {
    "schema_version": { "const": "planning_projection_spec_v1" },
    "table_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$" },
    "status": { "const": "active" },
    "source": {
      "type": "object",
      "required": ["project_id", "relative_file"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "relative_file": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "business_domain": { "type": "string" },
    "description": { "type": "string" },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sheet", "role"],
        "properties": {
          "sheet": { "type": "string", "minLength": 1 },
          "role": { "enum": ["primary", "enum"] },
          "header_rows": { "type": "object" },
          "primary_key": { "type": "array", "items": { "type": "string" } },
          "output": { "type": "string" },
          "keep_columns": { "type": "array", "items": { "type": "object" } },
          "drop_columns_reason": { "type": "string" },
          "layout": { "type": "string" },
          "outputs": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": true
      }
    },
    "validation": { "type": "object" }
  },
  "additionalProperties": false
}
