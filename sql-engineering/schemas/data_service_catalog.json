{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Data Service Catalog",
  "type": "object",
  "required": [
    "contract_version",
    "services"
  ],
  "properties": {
    "contract_version": {
      "const": "data_service_catalog_v1"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "service": {
      "type": "object",
      "required": [
        "service_id",
        "display_name",
        "product_ids",
        "adapter",
        "provider",
        "purposes",
        "evidence_role",
        "connection",
        "policy"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "product_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adapter": {
          "enum": [
            "sql_readonly",
            "browser_query"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "development_inspection",
              "production_query"
            ]
          }
        },
        "evidence_role": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "object"
        },
        "policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
