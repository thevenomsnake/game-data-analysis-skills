{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Lifecycle Scan",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "generated_at",
    "candidate_count",
    "review_required_count",
    "unchanged_skipped_count",
    "candidates",
    "relationships",
    "independent_pair_count",
    "unregistered_inventory"
  ],
  "properties": {
    "schema_version": { "const": "asset_lifecycle_scan_v2" },
    "project_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "review_required_count": { "type": "integer", "minimum": 0 },
    "unchanged_skipped_count": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "independent_pair_count": { "type": "integer", "minimum": 0 },
    "unregistered_inventory": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "candidate_key",
        "query_id",
        "version",
        "status",
        "workspace_status",
        "workspace_role",
        "role_lineage",
        "formalization_assessment",
        "ledger_decision",
        "target_package",
        "delivery_ready",
        "verification_state",
        "registered_output_count",
        "result_evidence_count",
        "content_fingerprint",
        "members",
        "relationship_facts",
        "review_status",
        "requires_review",
        "prior_decision",
        "prior_content_fingerprint"
      ],
      "properties": {
        "candidate_key": { "type": "string" },
        "query_id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "workspace_status": { "type": "string" },
        "workspace_role": { "enum": ["query", "dashboard_delivery", "unknown"] },
        "role_lineage": { "type": "object" },
        "formalization_assessment": { "type": "string" },
        "ledger_decision": { "type": "string" },
        "target_package": { "type": "object" },
        "delivery_ready": { "type": "boolean" },
        "verification_state": { "enum": ["verified", "unverified"] },
        "registered_output_count": { "type": "integer", "minimum": 0 },
        "result_evidence_count": { "type": "integer", "minimum": 0 },
        "content_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "members": { "type": "array", "minItems": 1 },
        "relationship_facts": {
          "type": "object",
          "required": ["sql_sha256", "logic_fingerprint", "tables", "metrics", "dimensions", "filters"],
          "properties": {
            "sql_sha256": { "type": "string" },
            "logic_fingerprint": { "type": "string" },
            "tables": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "metrics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "dimensions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "filters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "review_status": { "enum": ["new", "changed", "unchanged_skipped", "legacy_requires_review"] },
        "requires_review": { "type": "boolean" },
        "prior_decision": { "type": "string" },
        "prior_content_fingerprint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["left_candidate_key", "right_candidate_key", "relation", "evidence", "recommendation"],
      "properties": {
        "left_candidate_key": { "type": "string" },
        "right_candidate_key": { "type": "string" },
        "relation": { "enum": ["byte_identical", "same_logic", "strict_superset", "partial_overlap"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "recommendation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
