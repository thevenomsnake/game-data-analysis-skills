{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Provider Snapshot",
  "type": "object",
  "required": ["schema_version", "repository_id", "projects", "assets", "files", "snapshot_digest", "supported_contract_versions", "entry_points"],
  "properties": {
    "schema_version": { "const": "asset_provider_snapshot_v1" },
    "repository_id": { "type": "string", "minLength": 3 },
    "generated_at": { "type": "string" },
    "snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" }, "uniqueItems": true },
    "consumer_contract": { "$ref": "#/$defs/consumer_contract" },
    "supported_contract_versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "entry_points": { "type": "object", "additionalProperties": { "type": "string" } },
    "forbidden_local_surfaces": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "project": {
      "type": "object",
      "required": ["project_id", "project_path"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "project_path": { "$ref": "#/$defs/relative_path" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["asset_id", "project_id", "package_id", "manifest_path", "receipt_id", "files"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "package_id": { "type": "string", "minLength": 1 },
        "manifest_path": { "$ref": "#/$defs/relative_path" },
        "receipt_id": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/relative_path" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["path", "role", "sha256", "size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "role": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "consumer_contract": {
      "type": "object",
      "required": ["access_mode", "identity", "pin", "workspace_access"],
      "properties": {
        "access_mode": { "const": "read_only" },
        "identity": { "const": ["repository_id", "project_id", "asset_id"] },
        "pin": { "type": "array", "contains": { "const": "snapshot_digest" }, "items": { "type": "string" } },
        "workspace_access": { "const": "forbidden" }
      },
      "additionalProperties": false
    }
  }
}
